# Copy to .env and fill only for your selected broker/data provider
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_ACCESS_TOKEN=
LIVE_TRADING=false
FO_ENABLED=false
ENFORCE_MARKET_HOURS=true

# DATA_PROVIDER: "yfinance" (default) or "dhan"
DATA_PROVIDER=yfinance
# Required only when DATA_PROVIDER=dhan, or to use execution/dhan_broker.py.
# Get these from web.dhan.co -> My Profile -> DhanHQ Trading APIs.
# NEVER commit real values here or paste them into chat - this file is a
# template; put real credentials only in your local .env (gitignored).
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
CAPITAL=100000
RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.02
MAX_OPEN_RISK=0.02
MAX_TRADES_PER_DAY=3
MIN_SIGNAL_SCORE=75
